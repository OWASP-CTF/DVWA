# Neither the config file or its backup should go
# into the repo.
config/config.inc.php.bak
config/config.inc.php

# Vim swap files
.*swp

# VS Code editor files
*.code-workspace

# Used by pytest
tests/__pycache__/

# Don't include any uploaded images
hackable/uploads/*
# ...but the execution guard itself has to be tracked.
!hackable/uploads/.htaccess
.DS_Store
.DS_Store
